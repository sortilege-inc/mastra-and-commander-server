{
  "name": "mastra-and-commander-server",
  "version": "0.1.0",
  "description": "Play engine for the Mastra & Commander card game — boardgame.io engine + React. Framework ported from tcggg; game engine is a scaffold pending the locked design.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sortilege-inc/mastra-and-commander-server.git"
  },
  "license": "ISC",
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
